@using MassageHuis.ViewModels
@model MassageHuis.ViewModels.VerlofVM

@if (Model.VerlofGeregistreerd == true)
{
    <div id="verlofAlertContainer" class="container mt-4 py-3">
        <div id="verlofSuccessAlert" class="alert alert-success alert-dismissible fade show shadow-lg border-0 rounded-3" role="alert" data-bs-parent-id="verlofAlertContainer">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                <div>
                    <strong class="font-weight-bold d-block mb-1">Succes!</strong>
                    <span>Verlof succesvol geregistreerd</span>
                </div>
            </div>
            <button type="button" class="btn-close custom-alert-close-btn" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="prijsAlertContainer" class="container mt-4 py-3">
        <div id="prijsSuccessAlert" class="alert alert-success alert-dismissible fade show shadow-lg border-0 rounded-3" role="alert" data-bs-parent-id="prijsAlertContainer">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                <div>
                    <strong class="font-weight-bold d-block mb-1">Succes!</strong>
                    <span>Prijs succesvol gewijzigd.</span>
                </div>
            </div>
            <button type="button" class="btn-close custom-alert-close-btn" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewContext.ViewData.ModelState.IsValid)
{
    <div id="errorAlertContainer" class="container mt-4 py-3">
        <div id="modelStateErrorAlert" class="alert alert-danger alert-dismissible fade show shadow-lg border-0 rounded-3" role="alert" data-bs-parent-id="errorAlertContainer">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                <div>
                    <strong class="font-weight-bold d-block mb-1">Er zijn problemen opgetreden:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var keyValuePair in ViewContext.ViewData.ModelState)
                        {
                            var key = keyValuePair.Key;
                            var modelState = keyValuePair.Value;
                            @foreach (var error in modelState.Errors)
                            {
                                @if (string.IsNullOrEmpty(key) || key == "VerlofRegistratie")
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        }
                    </ul>
                </div>
            </div>
            <button type="button" class="btn-close custom-alert-close-btn" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="container mt-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Masseurs</h5>
                    <h6 class="admin-tile-subtitle">Beheer personeel</h6>
                    <p class="card-text small">Nieuwe masseurs toevoegen, bestaande uit dienst nemen.</p>
                    <a asp-controller="Admin" asp-action="Details" asp-route-id="c24a2c9f-9ded-461c-ab1d-6f8599acaa5e" class="admin-tile-link">Ga naar Masseursbeheer <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                    <i class="bi bi-calendar-event-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Verlof</h5>
                    <h6 class="admin-tile-subtitle">Plan verlofdagen</h6>
                    <p class="card-text small">Verlof van het massagehuis inplannen en beheren.</p>
                    <a asp-action="VerlofAanvraag" class="admin-tile-link">Verlof Invullen <i class="bi bi-arrow-right-short"></i></a>
                    <a asp-action="VerlofOverzicht" class="admin-tile-link">Verlof Overzicht <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center">
                    <i class="bi bi-tag-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Prijzen</h5>
                    <h6 class="admin-tile-subtitle">Bekijk & pas aan</h6>
                    <p class="card-text small">Prijzen van de verschillende massages bekijken en aanpassen.</p>
                    <a asp-action="Index" asp-controller="Prijzen" class="admin-tile-link">Wijzig Prijzen <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100 disabled-tile">
                <div class="card-body text-center">
                    <i class="bi bi-person-lines-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Klanten</h5>
                    <h6 class="admin-tile-subtitle">Details & historie</h6>
                    <p class="card-text small">Klantendetails, historie van massages en toekomstige boekingen bekijken.</p>
                    <a href="#" class="admin-tile-link">Ga naar Klantenbeheer <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100 disabled-tile">
                <div class="card-body text-center">
                    <i class="bi bi-ticket-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Promocodes</h5>
                    <h6 class="admin-tile-subtitle">Aanmaken & bekijken</h6>
                    <p class="card-text small">Promotiecodes en cadeaubonnen aanmaken en bekijken.</p>
                    <a href="#" class="admin-tile-link">Ga naar Promo Beheer <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-week-fill"></i>
                    <h5 class="admin-tile-title">Week Overzicht</h5>
                    <h6 class="admin-tile-subtitle">Bekijk Reservaties</h6>
                    <p class="card-text small">Hier kunnen de reservaties van deze week bekenen worden</p>
                    <a class="admin-tile-link mt-2" asp-controller="Reservatie" asp-action="KlantReservatieOverzicht">Ga naar Weekoverzicht <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select all alerts that are dismissible
            var alerts = document.querySelectorAll('.alert.alert-dismissible');

            alerts.forEach(function(alertElement) {
                // Add event listener for when the alert is closed
                alertElement.addEventListener('closed.bs.alert', function () {
                    // Get the ID of the parent container from the data attribute
                    var parentContainerId = this.dataset.bsParentId;

                    if (parentContainerId) {
                        var parentContainer = document.getElementById(parentContainerId);
                        if (parentContainer) {
                            parentContainer.remove(); // Remove the entire container from the DOM
                        }
                    }
                });
            });
        });
    </script>
}