@using MassageHuis.ViewModels
@model MassageHuis.ViewModels.MasseurVM

<div class="row justify-content-center">
        <div class="col-sm-6 col-md-4 col-lg-3 d-flex justify-content-center">
            <div class="card" style="width: 18rem;">
                <img class="card-img-top" src="https://placehold.co/150x150/png" alt="Placeholder Foto Massage">
                <div class="card-body">
                    <form asp-controller="Klant" asp-action="Index" method="post">
                        <h5 class="card-title">Type Massage</h5>
                        <p class="card-text">
                            Beschrijving van het type massage
                        </p>
                        <input type="hidden" name="Id" value="" />
                        <button type="submit" class="btn btn-primary">Bekijk Masseurs</button>
                    </form>
                </div>
            </div>
        </div>
</div>
