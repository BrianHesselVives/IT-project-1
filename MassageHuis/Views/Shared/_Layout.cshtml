@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="nl" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MassageHuis</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MassageHuis.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap" rel="stylesheet">
</head>

<body class="d-flex flex-column min-vh-100 bg-light text-dark">

    <header>
        
        <nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm sticky-top">
            <div class="container px-3 py-2"> 
                @if (!User.Identity.IsAuthenticated ||
                            (User.Identity.IsAuthenticated &&
                            !(await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater") ||
                            await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur") ||
                            await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator"))))
                            {
                <a class="navbar-brand fs-4 fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">MassageHuis</a>
                <button class="navbar-toggler px-3 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>
                }
                else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur")){
                    <a class="navbar-brand fs-4 fw-bold text-primary" asp-area="" asp-controller="Masseur" asp-action="Index">MassageHuis</a>
                <button class="navbar-toggler px-3 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>
                }
                else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater")){
                    <a class="navbar-brand fs-4 fw-bold text-primary" asp-area="" asp-controller="Uitbater" asp-action="Index">MassageHuis</a>
                <button class="navbar-toggler px-3 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>
                }
                else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator")){
                    <a class="navbar-brand fs-4 fw-bold text-primary" asp-area="" asp-controller="Admin" asp-action="Index">MassageHuis</a>
                <button class="navbar-toggler px-3 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>
                }
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-md-0">
                        @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark px-3 py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-key-fill me-1"></i> Admin Overzicht</a>
                            </li>
                        }
                        else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark px-3 py-2" asp-controller="Uitbater" asp-action="Index"><i class="bi bi-clipboard-pulse"></i> Mijn Overzicht</a>
                            </li>
                        }
                        else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark px-3 py-2" asp-controller="Masseur" asp-action="Index"><i class="bi bi-clipboard-pulse"></i> Mijn Overzicht</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex">

                        @{
                            if (!User.Identity.IsAuthenticated ||
                            (User.Identity.IsAuthenticated &&
                            !(await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater") ||
                            await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur") ||
                            await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator"))))
                            {
                                <a class="btn btn-primary btn-primary-custom fw-semibold py-2 px-4 rounded-lg shadow-sm me-2" asp-fragment="services" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-calendar3-event"></i> Boek nu een afspraak
                                </a>
                            }
                        }
                        
                    </div>
                </div>
            <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-3 mt-auto">
        <div class="container text-center">
            <p class="mb-1">&copy; @DateTime.Now.Year MassageHuis, Brian Hessel</p>
            <p class="text-muted small">123 Wellness, (Stad)</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js" integrity="sha384-RuyvpeZCxMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>