@using Microsoft.AspNetCore.Identity
@using MassageHuis.Models;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="mijnAccountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i> Mijn Account
            </a>
            <ul class="dropdown-menu" aria-labelledby="mijnAccountDropdown">
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"><i class="bi bi-person"></i>  Mijn Profiel</a></li>
                <li><hr class="dropdown-divider"></li>
                @if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "klant"))
                {
                <li><a class="dropdown-item" asp-controller="Reservatie" asp-action="KlantReservatieOverzicht"><i class="bi bi-calendar3-event"></i> Reservaties</a></li>
                <li><hr class="dropdown-divider"></li>
                }
                <li>
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item "><i class="bi bi-box-arrow-right "></i> Uitloggen</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item ms-lg-2">
            @* btn-login-animated *@
            <a class="nav-link text-dark px-3 py-2 " id="login" asp-area="Identity" asp-page="/Account/Login">
                <span class="icon-only"><i class="bi bi-person"></i></span>
                <span class="full-text">Aanmelden</span>
            </a>
        </li>
    }
</ul>
