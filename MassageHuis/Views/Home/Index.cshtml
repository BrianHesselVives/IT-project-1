@using MassageHuis.ViewModels
@model MassageHuis.ViewModels.ReservatieVM

<div id="alertContainer" class="container py-3">
    @if (Model != null && Model.GeselecteerdSlot != null)
    {
        <div id="razorSuccessAlert" class="alert alert-success alert-dismissible fade show shadow-lg border-0 rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i> 
                <div>
                    <strong class="font-weight-bold d-block mb-1">Succes!</strong> 
                    <span>Uw massage is succesvol gereserveerd op <span class="fw-semibold">@Model.GeselecteerdSlot</span></span>
                </div>
            </div>
            <button type="button" class="btn-close custom-alert-close-btn" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<div class="hero-gradient d-flex align-items-center justify-content-center py-5">
    <div class="text-center mx-auto" style="max-width: 800px;">
        <h1 class="display-4 fw-bold text-dark mb-4">
            Ervaar Ultieme <span class="text-primary">Ontspanning</span> bij MassageHuis
        </h1>
        <p class="mt-3 fs-5 text-secondary mx-auto mb-4">
            Duik in de wereld van pure ontspanning met onze premium massages. Speciaal ontworpen om uw lichaam te verjongen en uw geest tot rust te brengen. Boek vandaag nog uw persoonlijk verwenmoment!
        </p>
        <div class="mt-4 d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a href="#services" class="btn btn-primary btn-primary-custom fs-5 fw-semibold py-3 px-5 rounded-lg shadow-lg">
                Boek nu een afspraak
            </a>
            <a href="#services" class="btn btn-outline-primary btn-secondary-custom fs-5 fw-semibold py-3 px-5 rounded-lg shadow-lg">
                Bekijk aanbod
            </a>
        </div>
    </div>
</div>

<section id="services" class="section-padding bg-white">
    <div class="container px-3">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-dark mb-3">Onze Massagediensten</h2>
            <p class="text-secondary mx-auto" style="max-width: 600px;">Kies uit ons aanbod van professionele massagetherapieën, afgestemd op uw specifieke behoeften.</p>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model.TypeMassages)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 bg-info bg-opacity-10">
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title h4 fw-semibold text-dark mb-2">@item.Type</h3>
                            <p class="card-subtitle text-muted mb-3">60 minuten</p>
                            <p class="card-text text-secondary flex-grow-1 mb-4">@item.Beschrijving</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <p class="card-text fs-5 fw-semibold text-primary mb-0">€@item.Prijs</p>
                                <a asp-action="Index" asp-controller="Klant" asp-route-IdTypeMassage="@item.Id" class="btn btn-primary btn-primary-custom btn-sm">Boek Nu</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
