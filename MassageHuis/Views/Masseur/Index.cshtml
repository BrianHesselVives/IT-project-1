@using MassageHuis.ViewModels
@model MassageHuis.ViewModels.VerlofVM
@if (Model.VerlofGeregistreerd == true)
{
    <div id="verlofAlertContainer" class="container mt-4 py-3">
        <div id="verlofSuccessAlert" class="alert alert-success alert-dismissible fade show shadow-lg border-0 rounded-3" role="alert" data-bs-parent-id="verlofAlertContainer">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                <div>
                    <strong class="font-weight-bold d-block mb-1">Succes!</strong>
                    <span>Verlof succesvol geregistreerd</span>
                </div>
            </div>
            <button type="button" class="btn-close custom-alert-close-btn" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewContext.ViewData.ModelState.IsValid)
{
    <div id="modelStateErrorAlertContainer" class="container mt-4 py-3">
        <div id="modelStateErrorAlert" class="alert alert-danger alert-dismissible fade show shadow-lg border-0 rounded-3" role="alert" data-bs-parent-id="modelStateErrorAlertContainer">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i> 
                <div>
                    <strong class="font-weight-bold d-block mb-1">Er zijn problemen opgetreden:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var keyValuePair in ViewContext.ViewData.ModelState)
                        {
                            var key = keyValuePair.Key;
                            var modelState = keyValuePair.Value;
                            @foreach (var error in modelState.Errors)
                            {
                                @if (string.IsNullOrEmpty(key) || key == "VerlofRegistratie")
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        }
                    </ul>
                </div>
            </div>
            <button type="button" class="btn-close custom-alert-close-btn" data-bs-dismiss="alert" aria-label="Close"></button> 
        </div>
    </div>
}

<div class="container mt-4">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                    <i class="bi bi-calendar-event-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Verlof</h5>
                    <h6 class="admin-tile-subtitle">Plan verlofdagen</h6>
                    <p class="card-text small">Verlof van het massagehuis inplannen en beheren.</p>
                    <a asp-controller="Uitbater" asp-action="VerlofAanvraag" class="admin-tile-link">Verlof Invullen <i class="bi bi-arrow-right-short"></i></a>
                    <a asp-controller="Uitbater" asp-action="VerlofOverzicht" class="admin-tile-link">Verlof Overzicht <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                    <i class="bi bi-calendar-plus-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Verlof</h5>
                    <h6 class="admin-tile-subtitle">Schema's'</h6>
                    <p class="card-text small">Vul hier de datums in waarop er gereserveerd kan worden</p>
                    <a asp-controller="Masseur" asp-action="SchemaWijzigen" class="admin-tile-link">Schema Toevoegen <i class="bi bi-arrow-right-short"></i></a>
                    <a asp-controller="Masseur" asp-action="SchemaOverzicht" class="admin-tile-link">Schema Overzicht <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card admin-tile h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-week-fill admin-tile-icon"></i>
                    <h5 class="admin-tile-title">Week Overzicht</h5>
                    <h6 class="admin-tile-subtitle">Bekijk Reservaties</h6>
                    <p class="card-text small">Hier kunnen de reservaties van deze week bekenen worden</p>
                    <a class="admin-tile-link mt-2" asp-controller="Reservatie" asp-action="KlantReservatieOverzicht">Ga naar Weekoverzicht <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select all alerts that are dismissible
            var alerts = document.querySelectorAll('.alert.alert-dismissible');

            alerts.forEach(function(alertElement) {
                // Add event listener for when the alert is closed
                alertElement.addEventListener('closed.bs.alert', function () {
                    // Get the ID of the parent container from the data attribute
                    var parentContainerId = this.dataset.bsParentId;

                    if (parentContainerId) {
                        var parentContainer = document.getElementById(parentContainerId);
                        if (parentContainer) {
                            parentContainer.remove(); // Remove the entire container from the DOM
                        }
                    }
                });
            });
        });
    </script>
}