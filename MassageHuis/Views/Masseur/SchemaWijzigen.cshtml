<div class="container py-5">
        <h1 class="mb-4 text-primary">Nieuw schema</h1>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Datum Selectie</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Type datumselectie:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="dateSelectionType" id="singleDate" value="single" checked>
                        <label class="form-check-label" for="singleDate">Eén specifieke datum</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="dateSelectionType" id="dateRange" value="range">
                        <label class="form-check-label" for="dateRange">Datumbereik (vanaf - t.e.m.)</label>
                    </div>
                </div>

                <div id="singleDateFields" class="mb-3">
                    <label for="specificDate" class="form-label">Kies datum:</label>
                    <input type="date" class="form-control" id="specificDate" name="specificDate" required>
                </div>

                <div id="dateRangeFields" class="row g-3" style="display: none;">
                    <div class="col-md-6">
                        <label for="startDate" class="form-label">Datum bereik:</label>
                        <input type="date" class="form-control" id="startDate" name="startDate">
                    </div>
                    
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Tijdsloten per Dag</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Selecteer dagen om hun tijdsloten te configureren.</p>

                <div class="d-flex flex-wrap justify-content-between mb-3 p-3 border rounded bg-light" id="dagOverzicht">
                    <h6 class="w-100 mb-2">Selecteer dagen:</h6>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-monday" data-day="monday" checked>
                        <label class="form-check-label" for="topCheckbox-monday">Ma</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-tuesday" data-day="tuesday" checked>
                        <label class="form-check-label" for="topCheckbox-tuesday">Di</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-wednesday" data-day="wednesday" checked>
                        <label class="form-check-label" for="topCheckbox-wednesday">Wo</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-thursday" data-day="thursday" checked>
                        <label class="form-check-label" for="topCheckbox-thursday">Do</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-friday" data-day="friday" checked>
                        <label class="form-check-label" for="topCheckbox-friday">Vr</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-saturday" data-day="saturday" checked>
                        <label class="form-check-label" for="topCheckbox-saturday">Za</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-sunday" data-day="sunday" checked>
                        <label class="form-check-label" for="topCheckbox-sunday">Zo</label>
                    </div>
                </div>

                <div class="accordion" id="timeSlotsAccordion">
                    <div class="accordion-item" id="accordionItem-monday">
                        <h2 class="accordion-header" id="headingMonday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMonday" aria-expanded="false" aria-controls="collapseMonday">
                                Maandag
                            </button>
                        </h2>
                        <div id="collapseMonday" class="accordion-collapse collapse" aria-labelledby="headingMonday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="mondayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="monday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" id="accordionItem-tuesday">
                        <h2 class="accordion-header" id="headingTuesday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTuesday" aria-expanded="false" aria-controls="collapseTuesday">
                                Dinsdag
                            </button>
                        </h2>
                        <div id="collapseTuesday" class="accordion-collapse collapse" aria-labelledby="headingTuesday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="tuesdayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="tuesday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" id="accordionItem-wednesday">
                        <h2 class="accordion-header" id="headingWednesday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWednesday" aria-expanded="false" aria-controls="collapseWednesday">
                                Woensdag
                            </button>
                        </h2>
                        <div id="collapseWednesday" class="accordion-collapse collapse" aria-labelledby="headingWednesday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="wednesdayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="wednesday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" id="accordionItem-thursday">
                        <h2 class="accordion-header" id="headingThursday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThursday" aria-expanded="false" aria-controls="collapseThursday">
                                Donderdag
                            </button>
                        </h2>
                        <div id="collapseThursday" class="accordion-collapse collapse" aria-labelledby="headingThursday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="thursdayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="thursday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" id="accordionItem-friday">
                        <h2 class="accordion-header" id="headingFriday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFriday" aria-expanded="false" aria-controls="collapseFriday">
                                Vrijdag
                            </button>
                        </h2>
                        <div id="collapseFriday" class="accordion-collapse collapse" aria-labelledby="headingFriday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="fridayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="friday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" id="accordionItem-saturday">
                        <h2 class="accordion-header" id="headingSaturday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSaturday" aria-expanded="false" aria-controls="collapseSaturday">
                                Zaterdag
                            </button>
                        </h2>
                        <div id="collapseSaturday" class="accordion-collapse collapse" aria-labelledby="headingSaturday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="saturdayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="saturday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item" id="accordionItem-sunday">
                        <h2 class="accordion-header" id="headingSunday">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSunday" aria-expanded="false" aria-controls="collapseSunday">
                                Zondag
                            </button>
                        </h2>
                        <div id="collapseSunday" class="accordion-collapse collapse" aria-labelledby="headingSunday" data-bs-parent="#timeSlotsAccordion">
                            <div class="accordion-body">
                                <div id="sundayTimeSlots" class="time-slot-container">
                                    <h6>Tijdsloten:</h6>
                                </div>
                                <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="sunday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary btn-lg" id="saveScheduleBtn">Schema Opslaan</button>
        </div>
    </div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/nl.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const dayCheckboxes = document.querySelectorAll('.top-day-checkbox');
                const addTimeSlotButtons = document.querySelectorAll('.add-time-slot');
                const singleDateRadio = document.getElementById('singleDate');
                const dateRangeRadio = document.getElementById('dateRange');
                const singleDateFields = document.getElementById('singleDateFields');
                const dateRangeFields = document.getElementById('dateRangeFields');
                const specificDateInput = document.getElementById('specificDate');
                const startDateInput = document.getElementById('startDate');
                const dagOverzicht = document.getElementById('dagOverzicht');
                const timeSlotsAccordion = document.getElementById('timeSlotsAccordion');

                // Flatpickr initialisatie voor de datumvelden
                const specificDatePicker = flatpickr(specificDateInput, {
                    locale: "nl",
                    dateFormat: "Y-m-d",
                    minDate: "today", // Startdatum kan niet voor de huidige datum zijn
                    onChange: function(selectedDates, dateStr, instance) {
                        // Als de specifieke datum verandert, pas de zichtbaarheid van de dag-accordion aan
                        if (singleDateRadio.checked) {
                            toggleDateInputs();
                        }
                    }
                });

                const rangeStartDatePicker = flatpickr(startDateInput, {
                    locale: "nl",
                    mode: "range",
                    dateFormat: "Y-m-d",
                    minDate: "today", // Startdatum kan niet voor de huidige datum zijn
                    onChange: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length > 0) {
                            rangeEndDatePicker.set('minDate', selectedDates[0]);
                        } else {
                            rangeEndDatePicker.set('minDate', "today");
                        }
                    }
                });

                function TijslotenControle(vorigTimeslot, sMinOffset, eMinOffset) {
                    let tempTime = vorigTimeslot.split(":");
                    let dt = new Date();
                    dt.setHours(parseInt(tempTime[0]));
                    dt.setMinutes(parseInt(tempTime[1]));

                    let dtS = new Date(dt.getTime() + sMinOffset * 60000);
                    let dtE = new Date(dt.getTime() + eMinOffset * 60000);

                    const startTime = dtS.getHours().toString().padStart(2, "0") + ":" + dtS.getMinutes().toString().padStart(2, "0");
                    const endTime = dtE.getHours().toString().padStart(2, "0") + ":" + dtE.getMinutes().toString().padStart(2, "0");
                    return [startTime, endTime];
                }

                function addTimeSlot(dayId, startTime = '09:00', endTime = '10:00') {
                    let container = document.getElementById(`${dayId}TimeSlots`);
                    let timeSlotsInContainer = container.querySelectorAll('.time-slot-row'); // Gebruik een specifieke klasse voor de rijen
                    let newSlot = document.createElement('div');
                    newSlot.className = `input-group mb-3 time-slot-row ${dayId}TimeSlots`; // Voeg een herkenbare klasse toe
                    newSlot.id = dayId + "TimeSlot" + timeSlotsInContainer.length;

                    if (timeSlotsInContainer.length > 0) {
                        const lastEndTimeInput = timeSlotsInContainer[timeSlotsInContainer.length - 1].querySelector('.end-time-input');
                        [startTime, endTime] = TijslotenControle(lastEndTimeInput.value, 0, 60); // Offset van 0 voor start, 60 voor eind
                    }

                    newSlot.innerHTML = `
                        <input type="text" class="form-control start-time-input" value="${startTime}" />
                        <input type="text" class="form-control end-time-input" value="${endTime}" disabled />
                        <button class="btn btn-danger remove-time-slot" type="button"><i class="bi bi-trash"></i></button>
                    `;
                    container.appendChild(newSlot);

                    // Flatpickr voor de starttijd van het nieuwe slot
                    const startTimeInput = newSlot.querySelector('.start-time-input');
                    const endTimeInput = newSlot.querySelector('.end-time-input');

                    const newStartTimePicker = flatpickr(startTimeInput, {
                        enableTime: true,
                        noCalendar: true,
                        dateFormat: "H:i",
                        time_24hr: true,
                        minuteIncrement: 15,
                        minTime: (timeSlotsInContainer.length > 0) ? TijslotenControle(timeSlotsInContainer[timeSlotsInContainer.length - 1].querySelector('.end-time-input').value, 0, 0)[0] : "00:00",
                        onChange: function(selectedDates, dateStr, instance) {
                            const [newSlotStartTime, newSlotEndTime] = TijslotenControle(dateStr, 15, 60); // 15 min slot, 60 min duur
                            endTimeInput.value = newSlotEndTime;
                            // Update minTime voor de volgende starttijd als er een volgend slot is
                            const nextSlotIndex = Array.from(container.querySelectorAll('.time-slot-row')).indexOf(newSlot) + 1;
                            if (nextSlotIndex < container.querySelectorAll('.time-slot-row').length) {
                                const nextStartTimeInput = container.querySelectorAll('.time-slot-row')[nextSlotIndex].querySelector('.start-time-input');
                                if (nextStartTimeInput && nextStartTimeInput._flatpickr) {
                                    nextStartTimeInput._flatpickr.set('minTime', newSlotEndTime);
                                }
                            }
                        }
                    });

                    // Update de minTime voor de starttijden van bestaande slots na een wijziging
                    updateMinTimesForExistingSlots(dayId);

                    // Voeg event listener toe aan de verwijderknop
                    newSlot.querySelector('.remove-time-slot').addEventListener('click', function() {
                        newSlot.remove();
                        updateMinTimesForExistingSlots(dayId); // Update minTimes na verwijdering
                    });
                }

                // Functie om minTimes bij te werken voor alle tijdsloten in een dagcontainer
                function updateMinTimesForExistingSlots(dayId) {
                    const container = document.getElementById(`${dayId}TimeSlots`);
                    const timeSlotsInContainer = container.querySelectorAll('.time-slot-row');

                    timeSlotsInContainer.forEach((slot, index) => {
                        const startTimeInput = slot.querySelector('.start-time-input');
                        if (startTimeInput && startTimeInput._flatpickr) {
                            let minTimeForCurrentSlot = "00:00";
                            if (index > 0) {
                                const previousEndTimeInput = timeSlotsInContainer[index - 1].querySelector('.end-time-input');
                                minTimeForCurrentSlot = previousEndTimeInput.value;
                            }
                            startTimeInput._flatpickr.set('minTime', minTimeForCurrentSlot);
                        }
                    });
                }


                function getDayName(dateStr, locale) {
                    const date = new Date(dateStr);
                    return date.toLocaleDateString(locale, { weekday: 'long' }).toLowerCase();
                }

                function toggleDateInputs() {
                    const timeSlotContainers = document.querySelectorAll(".time-slot-container");

                    // Verwijder alle tijdsloten in de containers
                    timeSlotContainers.forEach(container => {
                        const slots = container.querySelectorAll('.time-slot-row');
                        for (let i = slots.length - 1; i >= 0; i--) {
                            slots[i].remove();
                        }
                    });

                    if (singleDateRadio.checked) {
                        singleDateFields.classList.remove('d-none');
                        dateRangeFields.style.display = 'none';
                        specificDateInput.setAttribute('required', 'true');
                        startDateInput.removeAttribute('required');


                        dagOverzicht.classList.add('d-none');
                        timeSlotsAccordion.classList.remove('d-none');

                        const dayCheckboxes = document.querySelectorAll('.top-day-checkbox');
                        const dayAccordionItems = document.querySelectorAll('.accordion-item');
                        const selectedDayName = getDayName(specificDateInput.value, "en-US");

                        dayCheckboxes.forEach(checkbox => {
                            const dayId = checkbox.getAttribute('data-day');
                            const dayAccordionItem = document.getElementById(`accordionItem-${dayId}`);

                            if (dayId === selectedDayName) {
                                checkbox.checked = true;
                                dayAccordionItem.classList.remove('d-none');
                                const collapseElement = dayAccordionItem.querySelector('.accordion-collapse');
                                if (collapseElement && !collapseElement.classList.contains('show')) {
                                    new bootstrap.Collapse(collapseElement, { toggle: true });
                                }
                            } else {
                                checkbox.checked = false;
                                dayAccordionItem.classList.add('d-none');
                                const collapseElement = dayAccordionItem.querySelector('.accordion-collapse');
                                if (collapseElement && collapseElement.classList.contains('show')) {
                                    new bootstrap.Collapse(collapseElement, { toggle: false });
                                }
                            }
                        });

                    } else { // dateRangeRadio.checked
                        singleDateFields.classList.add('d-none');
                        dateRangeFields.style.display = 'flex';
                        specificDateInput.removeAttribute('required');
                        startDateInput.setAttribute('required', 'true');

                        dagOverzicht.classList.remove('d-none');
                        timeSlotsAccordion.classList.remove('d-none');

                        const dayCheckboxes = document.querySelectorAll('.top-day-checkbox');
                        const dayAccordionItems = document.querySelectorAll('.accordion-item');
                        dayCheckboxes.forEach(checkbox => {
                            checkbox.checked = false;
                        });
                        dayAccordionItems.forEach(item => {
                            item.classList.add('d-none');
                            const collapseElement = item.querySelector('.accordion-collapse');
                            if (collapseElement && collapseElement.classList.contains('show')) {
                                new bootstrap.Collapse(collapseElement, { toggle: false });
                            }
                        });
                    }
                }

                // Event listeners voor radio knoppen
                singleDateRadio.addEventListener('change', toggleDateInputs);
                dateRangeRadio.addEventListener('change', toggleDateInputs);
                specificDateInput.addEventListener('change', toggleDateInputs); // Re-trigger bij datumwijziging voor "enkele datum"

                // Initialiseer bij het laden van de pagina
                toggleDateInputs();

                // Klikken op de knop om tijdslots toe te voegen per dag
                addTimeSlotButtons.forEach(button => {
                    button.addEventListener('click', function() {
                        const day = button.getAttribute('data-day');
                        addTimeSlot(day);
                    });
                });

                // Toont/verbergt de tijdslot secties op basis van de checkbox status
                dayCheckboxes.forEach(checkbox => {
                    checkbox.addEventListener('change', function() {
                        const dayId = checkbox.getAttribute('data-day');
                        const dayAccordionItem = document.getElementById(`accordionItem-${dayId}`);
                        if (checkbox.checked) {
                            dayAccordionItem.classList.remove('d-none');
                        } else {
                            dayAccordionItem.classList.add('d-none');
                            // Sluit de accordeon als deze verborgen wordt
                            const collapseElement = dayAccordionItem.querySelector('.accordion-collapse');
                            if (collapseElement && collapseElement.classList.contains('show')) {
                                new bootstrap.Collapse(collapseElement, { toggle: false });
                            }
                            // Verwijder ook alle tijdsloten wanneer een dag wordt uitgevinkt
                            const container = document.getElementById(`${dayId}TimeSlots`);
                            const slots = container.querySelectorAll('.time-slot-row');
                            slots.forEach(slot => slot.remove());
                        }
                    });
                });
            });
        </script>
}
