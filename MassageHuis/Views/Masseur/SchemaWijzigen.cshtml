@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using MassageHuis.ViewModels
@using System.Globalization

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur")))
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur")))
                    {
                        <li class="breadcrumb-item"><a asp-controller="Masseur" asp-action="Index">Overzicht</a></li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">Nieuw Schema</li>
                </ol>
            </nav>
        }
        @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator")))
        {
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-return-left me-2"></i> Terug naar Overzicht
            </a>
        }
        else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "masseur"))
        {
            <a asp-controller="Masseur" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-return-left me-2"></i> Terug naar Overzicht
            </a>
        }
        else if (SignInManager.IsSignedIn(User) && await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater"))
        {
            <a asp-controller="Uitbater" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-return-left me-2"></i> Terug naar Overzicht
            </a>
        }
    </div> 

    <h1 class="mb-4 text-primary">Nieuw schema</h1>
    <div id="errorMessage" class="alert alert-danger d-none" role="alert"></div>
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Datum Selectie</h5>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Type datumselectie:</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="dateSelectionType" id="singleDate" value="single" checked>
                    <label class="form-check-label" for="singleDate">Eén specifieke datum</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="dateSelectionType" id="dateRange" value="range">
                    <label class="form-check-label" for="dateRange">Datumbereik (vanaf - t.e.m.)</label>
                </div>
            </div>
            <div class="mb-3">
                <label for="schemaNameInput" class="form-label">Naam van het schema:</label>
                <input type="text" class="form-control" id="schemaNameInput" name="SchemaName" placeholder="Bijv. 'Zomerschema 20__'" required>
                <div class="invalid-feedback">
                    Voer een naam in voor het schema.
                </div>
            </div>
            <div id="singleDateFields" class="mb-3">
                <label for="specificDate" class="form-label">Kies datum:</label>
                <input type="date" class="form-control" id="specificDate" name="specificDate" required>
            </div>

            <div id="dateRangeFields" class="row g-3" style="display: none;">
                <div class="mb-3">
                    <label for="startDate" class="form-label">Datum bereik:</label>
                    <input type="date" class="form-control" id="startDate" name="startDate">
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Tijdsloten per Dag</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">Selecteer dagen om hun tijdsloten te configureren.</p>

            <div class="d-flex flex-wrap justify-content-between mb-3 p-3 border rounded bg-light" id="dagOverzicht">
                <h6 class="w-100 mb-2">Selecteer dagen:</h6>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-monday" data-day="monday" checked>
                    <label class="form-check-label" for="topCheckbox-monday">Ma</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-tuesday" data-day="tuesday" checked>
                    <label class="form-check-label" for="topCheckbox-tuesday">Di</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-wednesday" data-day="wednesday" checked>
                    <label class="form-check-label" for="topCheckbox-wednesday">Wo</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-thursday" data-day="thursday" checked>
                    <label class="form-check-label" for="topCheckbox-thursday">Do</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-friday" data-day="friday" checked>
                    <label class="form-check-label" for="topCheckbox-friday">Vr</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-saturday" data-day="saturday" checked>
                    <label class="form-check-label" for="topCheckbox-saturday">Za</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input top-day-checkbox" type="checkbox" id="topCheckbox-sunday" data-day="sunday" checked>
                    <label class="form-check-label" for="topCheckbox-sunday">Zo</label>
                </div>
            </div>

            <div class="accordion" id="timeSlotsAccordion">
                <div class="accordion-item" id="accordionItem-monday">
                    <h2 class="accordion-header" id="headingMonday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMonday" aria-expanded="false" aria-controls="collapseMonday">
                            Maandag
                        </button>
                    </h2>
                    <div id="collapseMonday" class="accordion-collapse collapse" aria-labelledby="headingMonday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="mondayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="monday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-item" id="accordionItem-tuesday">
                    <h2 class="accordion-header" id="headingTuesday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTuesday" aria-expanded="false" aria-controls="collapseTuesday">
                            Dinsdag
                        </button>
                    </h2>
                    <div id="collapseTuesday" class="accordion-collapse collapse" aria-labelledby="headingTuesday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="tuesdayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="tuesday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-item" id="accordionItem-wednesday">
                    <h2 class="accordion-header" id="headingWednesday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWednesday" aria-expanded="false" aria-controls="collapseWednesday">
                            Woensdag
                        </button>
                    </h2>
                    <div id="collapseWednesday" class="accordion-collapse collapse" aria-labelledby="headingWednesday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="wednesdayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="wednesday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-item" id="accordionItem-thursday">
                    <h2 class="accordion-header" id="headingThursday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThursday" aria-expanded="false" aria-controls="collapseThursday">
                            Donderdag
                        </button>
                    </h2>
                    <div id="collapseThursday" class="accordion-collapse collapse" aria-labelledby="headingThursday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="thursdayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="thursday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-item" id="accordionItem-friday">
                    <h2 class="accordion-header" id="headingFriday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFriday" aria-expanded="false" aria-controls="collapseFriday">
                            Vrijdag
                        </button>
                    </h2>
                    <div id="collapseFriday" class="accordion-collapse collapse" aria-labelledby="headingFriday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="fridayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="friday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-item" id="accordionItem-saturday">
                    <h2 class="accordion-header" id="headingSaturday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSaturday" aria-expanded="false" aria-controls="collapseSaturday">
                            Zaterdag
                        </button>
                    </h2>
                    <div id="collapseSaturday" class="accordion-collapse collapse" aria-labelledby="headingSaturday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="saturdayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="saturday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>

                <div class="accordion-item" id="accordionItem-sunday">
                    <h2 class="accordion-header" id="headingSunday">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSunday" aria-expanded="false" aria-controls="collapseSunday">
                            Zondag
                        </button>
                    </h2>
                    <div id="collapseSunday" class="accordion-collapse collapse" aria-labelledby="headingSunday" data-bs-parent="#timeSlotsAccordion">
                        <div class="accordion-body">
                            <div id="sundayTimeSlots" class="time-slot-container">
                                <h6>Tijdsloten:</h6>
                            </div>
                            <button type="button" class="btn btn-success mt-2 add-time-slot" data-day="sunday"><i class="bi bi-plus-circle"></i> Tijdslot toevoegen</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirmSaveModal" tabindex="-1" aria-labelledby="confirmSaveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="confirmSaveModalLabel">Schema Opslaan Bevestigen</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Controleer de onderstaande gegevens voordat u het schema opslaat:</p>
                    <div class="mb-3">
                        <strong>Schema Naam:</strong> <span id="modalSchemaName"></span>
                    </div>
                    <div class="mb-3">
                        <strong>Datum(s):</strong> <span id="modalDates"></span>
                    </div>
                    <hr />
                    <h5>Geselecteerde Tijdsloten:</h5>
                    <div id="modalTimeSlotsSummary">
                        <p class="text-muted" id="noTimeSlotsMessage">Geen tijdsloten geselecteerd.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="button" class="btn btn-primary" id="confirmSaveBtn">Opslaan</button>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <button type="submit" class="btn btn-primary btn-lg" id="saveScheduleBtn">Schema Opslaan</button>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/nl.js"></script>
    <script src="~/js/time-slot-management.js"></script>
}