            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <button type="submit" class="btn btn-primary btn-lg" id="saveScheduleBtn">Schema Opslaan</button>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            const dayCheckboxes = document.querySelectorAll('.top-day-checkbox');
            const addTimeSlotButtons = document.querySelectorAll('.add-time-slot');
            const singleDateRadio = document.getElementById('singleDate');
            const dateRangeRadio = document.getElementById('dateRange');
            const singleDateFields = document.getElementById('singleDateFields');
            const dateRangeFields = document.getElementById('dateRangeFields');
            const specificDateInput = document.getElementById('specificDate');
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');

            function TijslotenControle(vorigTimeslot, sMinOffset, eMinOffset){
                        let tempTime = vorigTimeslot.split(":");
                        let dt = new Date();
                        dt.setHours(tempTime[0]);
                        dt.setMinutes(tempTime[1]);
                        dtS= new Date(dt.getTime() + sMinOffset*60000);
                        dtE= new Date(dt.getTime() + eMinOffset*60000);
                        if(dtS.getMinutes() < 10){
                            startTime = dtS.getHours()+":0"+dtS.getMinutes()

                        }
                        startTime = dtS.getHours().toString().padStart(2, "0")+":"+dtS.getMinutes().toString().padStart(2, "0")
                        endTime = dtE.getHours().toString().padStart(2, "0")+":"+dtE.getMinutes().toString().padStart(2, "0")
                        return [startTime, endTime]
                    }
            
            function addTimeSlot(dayId, startTime = '05:00', endTime = '06:00') {
                let container = document.getElementById(`${dayId}TimeSlots`);
                let slotNumber = document.getElementsByClassName(`${dayId}TimeSlots`);
                let newSlot = document.createElement('div');
                newSlot.className = `${dayId}TimeSlots`
                newSlot.id = dayId+ "TimeSlot" + slotNumber.length++
                newSlot.classList.add('input-group', 'mb-3');
                if(slotNumber.length != 0){
                    [startTime,endTime] =TijslotenControle(slotNumber[slotNumber.length - 1].getElementsByTagName("input")[1].value,15,75);
                }  
                newSlot.innerHTML = `
                    <input type="text" class="form-control time-input" value="${startTime}" />
                    <input type="text" class="form-control time-input" disabled value="${endTime}" />
                    <button class="btn btn-danger" type="button" onclick="removeTimeSlot(this)"><i class="bi bi-trash"></i></button>
                `;
                container.appendChild(newSlot);
                flatpickr(newSlot.querySelectorAll('.time-input'), {
                    enableTime: true,
                    noCalendar: true,
                    dateFormat: "H:i", // 24-hour format
                    time_24hr: true,    // Explicitly enforce 24-hour mode
                    minuteIncrement: 15, // Dit is de setting voor 15-minuten intervallen
                    minTime: endTime,
                    onOpen: function(selectedDates, dateStr, instance) {
                        const vorigeTijd = instance.input.parentElement.getElementsByTagName("input")[0].value;
                        if(instance.input.parentElement.parentElement.getElementsByTagName("div").length > 1){ // kijken naar het 
                            const nieuweMinTime = vorigeTijd;
                            instance.set('minTime', nieuweMinTime);
                        }
                        else{
                            instance.set('minTime', "00:00");
                        }
                    },
                    onChange: function(selectedDates, dateStr, instance) {
                        // 'instance' is het Flatpickr object, en 'instance.input' is het DOM-element
                        const changedInput = instance.input;
                        console.log("Flatpickr input gewijzigd:", changedInput.id || changedInput.name || changedInput.className);
                        console.log("Nieuwe waarde (dateStr):", dateStr); // dateStr is de geformatteerde tijdstring
                        [startTime,endTime] =TijslotenControle(instance.input.parentElement.getElementsByTagName("input")[0].value,15,60);
                        instance.input.parentElement.getElementsByTagName("input")[1].value = endTime;
                    }
                });
                }
                specificDateInput.valueAsDate = new Date();

            function toggleDateInputs() {
                if (singleDateRadio.checked) {
                    singleDateFields.style.display = 'block';
                    dateRangeFields.style.display = 'none';
                    specificDateInput.setAttribute('required', 'true');
                    startDateInput.removeAttribute('required');
                    endDateInput.removeAttribute('required');
                } else {
                    singleDateFields.style.display = 'none';
                    dateRangeFields.style.display = 'flex';
                    specificDateInput.removeAttribute('required');
                    startDateInput.setAttribute('required', 'true');
                    endDateInput.setAttribute('required', 'true');
                }
            }

            singleDateRadio.addEventListener('change', toggleDateInputs);
            dateRangeRadio.addEventListener('change', toggleDateInputs);

            toggleDateInputs();
            // Tijdslot verwijderen
            window.removeTimeSlot = function(button) {
                let laatsteItem = button.parentElement.parentElement.getElementsByTagName("div").length-1;
                console.log(laatsteItem);
                if(laatsteItem != 0){
                    let laatsteDiv = button.parentElement.parentElement.getElementsByTagName("div")[laatsteItem-1];
                    console.log(laatsteDiv.getElementsByTagName("input")[0]);
                    laatsteDiv.getElementsByTagName("input")[0].disabled = false;
                    laatsteDiv.getElementsByTagName("button")[0].disabled = false;
                }
                button.closest('.input-group').remove();
                
            }

            // Voeg standaard tijdslots toe aan elke dag
            const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
            days.forEach(day => addTimeSlot(day));

            // Klikken op de knop om tijdslots toe te voegen per dag 
            addTimeSlotButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const day = button.getAttribute('data-day');
                    if(button.parentElement.getElementsByTagName("div").length > 1){
                        let laatsteItem = button.parentElement.getElementsByTagName("div").length-1;
                        let laatsteDiv = button.parentElement.getElementsByTagName("div")[laatsteItem];
                        laatsteDiv.getElementsByTagName("input")[0].disabled = true;
                        laatsteDiv.getElementsByTagName("button")[0].disabled = true;
                        addTimeSlot(day);
                    }
                    else{
                        addTimeSlot(day);
                    }
                });
            });

            // Toont/verbergt de tijdslot secties op basis van de checkbox status
            dayCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const dayId = checkbox.getAttribute('data-day');
                    const dayAccordionItem = document.getElementById(`accordionItem-${dayId}`);
                    if (checkbox.checked) {
                        dayAccordionItem.style.display = 'block';
                    } else {
                        dayAccordionItem.style.display = 'none';
                    }
                });
            });
        });

    </script>

}