@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using MassageHuis.ViewModels
@using System.Globalization
@model List<ReservatieVM>
@{
    // Functie om te controleren of een datum in de huidige week valt
    bool IsDateInCurrentWeek(DateTime date)
    {
        DateTime vandaag = DateTime.Today;
        DayOfWeek eersteDagVanDeWeek = CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
        DateTime beginVanDeWeek = vandaag.AddDays(-(int)vandaag.DayOfWeek).AddDays((int)eersteDagVanDeWeek);
        DateTime eindeVanDeWeek = beginVanDeWeek.AddDays(7).AddSeconds(-1);
        return date >= beginVanDeWeek && date <= eindeVanDeWeek;
    }
}

<div class="container py-5">
    @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater")) || SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator")))
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater")))
                {
                    <li class="breadcrumb-item"><a asp-controller="Uitbater" asp-action="Index">Uitbater Overzicht</a></li>
                }
                @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "administrator")))
                {
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin Overzicht</a></li>
                }

                <li class="breadcrumb-item active" aria-current="page">Week Overzicht</li>
            </ol>
        </nav>
    }
    <h1 class="text-2xl font-semibold text-primary text-center mb-4">Overzicht Reservaties</h1>

    <div class="card shadow-md rounded-lg overflow-hidden">
        <div class="table-responsive">
            <table class="table table-striped table-hover m-0">
                <thead class="bg-light">
                    <tr>
                        @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater")))
                        {
                            <th scope="col" class="text-gray-700">Reservatie ID</th>
                            <th scope="col" class="text-gray-700">Klant</th>
                            <th scope="col" class="text-gray-700">Datum Creatie</th>
                            <th scope="col" class="text-gray-700">Masseur/Masseuse</th>
                            <th scope="col" class="text-gray-700">Behandeling</th>
                            <th scope="col" calss="text-gray-700">Datum En Tijd</th>
                            <th scope="col" class="text-gray-700"></th>
                        }
                        @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "klant")))
                        {
                            <th scope="col" class="text-gray-700">Reservatie ID</th>
                            <th scope="col" class="text-gray-700">Datum Creatie</th>
                            <th scope="col" class="text-gray-700">Masseur/Masseuse</th>
                            <th scope="col" class="text-gray-700">Behandeling</th>
                            <th scope="col" calss="text-gray-700">Datum En Tijd</th>
                            <th scope="col" class="text-gray-700"></th>
                        }

                    </tr>
                </thead>
                <tbody>
                    @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "klant")))
                    {
                        @foreach (var reservatie in Model)
                        {
                            
                            <tr>
                                <td><span class="fst-italic text-muted">@reservatie.Id</span></td>
                                <td><span>@reservatie.DatumCreatie</span></td>
                                <td><span class="fw-medium">@reservatie.MasseurNaam</span></td>
                                <td><span>@reservatie.TypeMassage</span></td>
                                <td><span>@reservatie.DatumReservatie</span></td>
                                <td>
                                    @if (reservatie.Status == "Gereserveerd"& reservatie.DatumReservatie>= DateTime.Today)
                                    {
                                        <span class="badge bg-success text-white">@reservatie.Status</span>
                                    }
                                    else if (reservatie.Status == "Geannuleerd")
                                    {
                                        <span class="badge bg-danger text-white">@reservatie.Status</span>
                                    }
                                    else if (reservatie.Status !="Geannuleerd" && reservatie.DatumReservatie<DateTime.Today)
                                    {
                                        <span class="badge bg-secondary text-white">Voltooid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@reservatie.Status</span>
                                    }
                                </td>
                                @if (reservatie.Status == "Gereserveerd" && reservatie.DatumReservatie > DateTime.Today.AddDays(4))// controle annulatie niet mogelijk indien minder dan 4 dagen tot massage
                                {
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#annuleerModal-@reservatie.Id">
                                            Annuleren
                                        </button>

                                        <div class="modal fade" id="annuleerModal-@reservatie.Id" tabindex="-1" aria-labelledby="annuleerModalLabel" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="annuleerModalLabel">Bevestiging Annulering</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Weet je zeker dat je deze reservering wilt annuleren?  Dit kan niet ongedaan gemaakt worden.
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sluiten</button>
                                                        <form method="post" asp-action="AnnuleerReservatie" asp-route-id="@reservatie.Id">
                                                            <button type="submit" class="btn btn-danger">Bevestigen Annulering</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td></td>
                                }
                            </tr>
                        
                    }
                    }
                    @if (SignInManager.IsSignedIn(User) && (await UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "uitbater")))
                    {
                        @foreach (var reservatie in Model)
                        {
                            @if (IsDateInCurrentWeek((DateTime)reservatie.DatumReservatie)&& reservatie.DatumReservatie>=DateTime.Today)
                            {
                                <tr>
                                    <td><span class="fst-italic text-muted">@reservatie.Id</span></td>
                                    <td><span>@reservatie.KlantNaam</span></td>
                                    <td><span>@reservatie.DatumCreatie</span></td>
                                    <td><span class="fw-medium">@reservatie.MasseurNaam</span></td>
                                    <td><span>@reservatie.TypeMassage</span></td>
                                    <td><span>@reservatie.DatumReservatie</span></td>
                                    <td>
                                        @if (reservatie.Status == "Gereserveerd" & reservatie.DatumReservatie >= DateTime.Today)
                                        {
                                            <span class="badge bg-success text-white">@reservatie.Status</span>
                                        }
                                        else if (reservatie.Status == "Geannuleerd")
                                        {
                                            <span class="badge bg-danger text-white">@reservatie.Status</span>
                                        }
                                        else if (reservatie.Status != "Geannuleerd" && reservatie.DatumReservatie < DateTime.Today)
                                        {
                                            <span class="badge bg-secondary text-white">Voltooid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@reservatie.Status</span>
                                        }
                                    </td>
                                    @if (reservatie.Status == "Gereserveerd" && reservatie.DatumReservatie > DateTime.Today.AddDays(4))// controle annulatie niet mogelijk indien minder dan 4 dagen tot massage
                                    {
                                        <td>
                                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#annuleerModal-@reservatie.Id">
                                                Annuleren
                                            </button>

                                            <div class="modal fade" id="annuleerModal-@reservatie.Id" tabindex="-1" aria-labelledby="annuleerModalLabel" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="annuleerModalLabel">Bevestiging Annulering</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Weet je zeker dat je deze reservering wilt annuleren?  Dit kan niet ongedaan gemaakt worden.
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sluiten</button>
                                                            <form method="post" asp-action="AnnuleerReservatie" asp-route-id="@reservatie.Id">
                                                                <button type="submit" class="btn btn-danger">Bevestigen Annulering</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
