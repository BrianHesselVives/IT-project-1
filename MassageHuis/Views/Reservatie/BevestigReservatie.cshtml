@using System.Globalization
@model MassageHuis.ViewModels.ReservatieVM
<div class="container py-5">
    <h2>Bevestig uw reservering</h2>
    <p>Controleer de details voordat u de reservering plaatst:</p>

    <dl class="row">
        <dt class="col-sm-3">Datum en tijd:</dt>
        <dd class="col-sm-9">@Model.GeselecteerdSlot</dd>

        <dt class="col-sm-3">Masseur:</dt>
        <dd class="col-sm-9">@Model.MasseurNaam</dd>

        <dt class="col-sm-3">Type massage:</dt>
        <dd class="col-sm-9">@Model.TypeMassage</dd>

        <dt class="col-sm-3">Prijs:</dt>
        <dd class="col-sm-9">€@Model.Prijs</dd>
    </dl>

    <div class="mb-3">
        <p>
            <a class="btn btn-link" data-bs-toggle="collapse" href="#kortingscodeVeld" role="button" aria-expanded="false" aria-controls="kortingscodeVeld" disabled>
                Kortingscode (optioneel)
            </a>
        </p>
        <div class="collapse" id="kortingscodeVeld">
            <div class="card card-body">
                <label for="kortingscode" class="form-label visually-hidden">Voer uw kortingscode in:</label>
                <input type="text" class="form-control" id="kortingscode" placeholder="Voer uw kortingscode in">
            </div>
        </div>
    </div>

    <form method="post" asp-controller="Reservatie" asp-action="BevestigReservatie">
        @Html.AntiForgeryToken()
        <input type="hidden" name="GeselecteerdSlot" value="@Model.GeselecteerdSlot" />
        <input type="hidden" name="IdTijdSlot" value="@Model.IdTijdSlot" />
        <input type="hidden" name="MasseurId" value="@Model.MasseurId" />
        <input type="hidden" name="MasseurNaam" value="@Model.MasseurNaam" />
        <input type="hidden" name="IdTypeMassage" value="@Model.IdTypeMassage" />
        <input type="hidden" name="TypeMassage" value="@Model.TypeMassage" />
        <button type="submit" class="btn btn-success">Reservering plaatsen</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Annuleren</a>
    </form>
</div>