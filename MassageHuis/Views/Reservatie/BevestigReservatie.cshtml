@using System.Globalization
@model MassageHuis.ViewModels.ReservatieVM

@{
    var culture = new CultureInfo("nl-BE");
}

<div class="container py-5">
    <h2 class="mb-4 text-center text-primary fw-bold"><span class="text-secondary">Bevestig uw Reservering</span></h2>
    <p class="lead text-center mb-4">Controleer de details voordat u de reservering definitief plaatst.</p>

    <div class="card shadow-lg border-0 rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <h3 class="card-title mb-4 text-center text-primary">Uw Boekingsdetails</h3>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-md-end text-muted fw-semibold">Datum en tijd:</dt>
                <dd class="col-sm-8 fw-bold text-primary">
                    @if (Model.GeselecteerdSlot.HasValue)
                    {
                        @Model.GeselecteerdSlot.Value.ToString("dddd d MMMM yyyy 'om' HH:mm", culture)
                    }
                    else
                    {
                        <span>Datum en tijd niet beschikbaar</span>
                    }
                </dd>

                <dt class="col-sm-4 text-md-end text-muted fw-semibold">Masseur:</dt>
                <dd class="col-sm-8 fw-bold">@Model.MasseurNaam</dd>

                <dt class="col-sm-4 text-md-end text-muted fw-semibold">Type massage:</dt>
                <dd class="col-sm-8 fw-bold">@Model.TypeMassage</dd>

                <dt class="col-sm-4 text-md-end text-muted fw-semibold">Prijs:</dt>
                <dd class="col-sm-8 fw-bold text-success fs-5">@Model.Prijs.ToString("C", culture)</dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-light">
        <div class="card-body">
            <p class="mb-3 text-center">
                <a class="btn btn-link text-decoration-none text-primary fw-medium" data-bs-toggle="collapse" href="#kortingscodeVeld" role="button" aria-expanded="false" aria-controls="kortingscodeVeld">
                    <i class="bi bi-tag-fill me-2"></i> Heeft u een kortingscode? (optioneel)
                </a>
            </p>
            <div class="collapse" id="kortingscodeVeld">
                <div class="input-group mb-3">
                    <label for="kortingscode" class="form-label visually-hidden">Voer uw kortingscode in:</label>
                    <input type="text" class="form-control" id="kortingscode" placeholder="Voer hier uw code in" aria-label="Kortingscode">
                    <button class="btn btn-outline-secondary" type="button" id="applyDiscountBtn">Toepassen</button>
                </div>
                <div id="discountMessage" class="form-text text-center mt-2"></div>
            </div>
        </div>
    </div>

    <form method="post" asp-controller="Reservatie" asp-action="BevestigReservatie" class="d-grid gap-2 d-md-flex justify-content-md-center">
        @Html.AntiForgeryToken()
        <input type="hidden" name="GeselecteerdSlot" value="@(Model.GeselecteerdSlot.HasValue? Model.GeselecteerdSlot.Value.ToString("O") : string.Empty)" />
        <input type="hidden" name="IdTijdSlot" value="@Model.IdTijdSlot" />
        <input type="hidden" name="MasseurId" value="@Model.MasseurId" />
        <input type="hidden" name="MasseurNaam" value="@Model.MasseurNaam" />
        <input type="hidden" name="IdTypeMassage" value="@Model.IdTypeMassage" />
        <input type="hidden" name="TypeMassage" value="@Model.TypeMassage" />
        <input type="hidden" name="Prijs" value="@Model.Prijs" />

        <button type="submit" class="btn btn-success btn-lg">
            <i class="bi bi-check-circle-fill me-2"></i> Reservering Plaatsen
        </button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">
            <i class="bi bi-x-circle-fill me-2"></i> Annuleren
        </a>
    </form>
</div>
