@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registratie bevestiging";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
        <p>
            Gelieve uw email te bevestigen.
        </p>
    }
    else
    {
        <p>
            Controleer alstublieft uw email om uw account te bevestigen.
        </p>
    }
}
