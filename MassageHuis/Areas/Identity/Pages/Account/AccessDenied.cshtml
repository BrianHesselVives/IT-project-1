@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Toegang geweigerd"; 
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<div class="access-denied-container"> 
    <div class="access-denied-card">
        <h1 class="access-denied-title">@ViewData["Title"]</h1>
        <p class="access-denied-message">
            U heeft geen toegang tot deze pagina.
        </p>
        <p class="access-denied-details">
            Dit kan komen doordat u niet de juiste rechten heeft, of omdat deze pagina alleen voor specifieke rollen beschikbaar is.
            Neem contact op met de beheerder als u denkt dat dit een fout is.
        </p>
    </div>
</div>