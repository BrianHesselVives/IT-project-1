@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Wachtwoord reset bevestiging";
}

<div class="login-page-container d-flex align-items-start justify-content-center min-vh-100 py-5">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="login-form-card text-center">
                    <h1 class="fw-bold mb-3 login-title">@ViewData["Title"]</h1>
                    <hr class="w-50 mx-auto mb-4" />

                    <p class="lead text-muted">
                        Gelieve uw mailbox te bekijken om verder te gaan met het resetten van het wachtwoord.
                    </p>
                    <p class="small text-muted mt-3">
                        Als u de e-mail niet ontvangt, controleer dan uw spammap of probeer het wachtwoord opnieuw in te stellen.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>