@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Wachtwoord reset bevestiging";
}

<div class="login-page-container d-flex align-items-start justify-content-center min-vh-100 py-5">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="login-form-card text-center">
                    <h1 class="fw-bold mb-3 login-title">@ViewData["Title"]</h1>
                    <hr class="w-50 mx-auto mb-4" />

                    <p class="lead text-muted">
                        Uw wachtwoord is opnieuw ingesteld. Klik <a asp-page="./Login" class="text-decoration-none">hier om in te loggen</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>